# --- OS / tooling noise ---------------------------------------------------
.DS_Store
**/.DS_Store
.grok/
research/.grok/
website/.kiro/

# --- encrypted design files -----------------------------------------------
# .pen files are encrypted and only meaningful through the Pencil MCP tools.
**/*.pen
research/designs/
website/sv.pen

# --- large binary source material -----------------------------------------
# Kept locally, not in history: multi-megabyte client documents and the raw
# scraped image sets.
*.xlsx
Website Research and Replication Strategy.docx
website/images/
website/images/**/*
website/pasted-image*.pdf
research/assets/

# --- duplicated research deliverable --------------------------------------
# research/*.html are byte-identical to the copies at the repo root. The root
# copies are the ones tracked; these are ignored so the pair cannot drift.
research/*.html

# --- svmh-v2 build artefacts ----------------------------------------------
# Test output is regenerated by 04_TEST/run.sh on every run.
svmh-v2/04_TEST/reports/*
!svmh-v2/04_TEST/reports/.gitkeep

# Python caches from the tools/ and 04_TEST/ scripts.
__pycache__/
*.py[cod]

# Scratch screenshots decoded by tools/shotcut.py land in /tmp, but catch any
# that get written next to the project by mistake.
shot_raw.jpg
shot_view.jpg
shot_seg*.jpg
